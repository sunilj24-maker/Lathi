# -----------------------------------------------------------------------
# IITK Accessible — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git — it is already in .gitignore.
# -----------------------------------------------------------------------

# Resend API key — get it from https://resend.com/api-keys
# Format: re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=re_YOUR_RESEND_API_KEY_HERE

# Sender email — must be from a verified domain in your Resend account.
# For testing, Resend provides: onboarding@resend.dev (only sends to your own email)
# For production: use something like feedback@yourdomain.com
FEEDBACK_SENDER_EMAIL=feedback@yourdomain.com

# Receiver email — where you want to receive the feedback reports
FEEDBACK_RECEIVER_EMAIL=your@email.com

# (Optional) Change the API server port (default: 3001)
# API_PORT=3001
