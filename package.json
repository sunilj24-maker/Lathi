{
  "name": "lathi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "IITK Accessible — accessibility-aware pedestrian navigation for IIT Kanpur, built on OpenStreetMap data.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "data:fetch": "node scripts/fetch-osm.mjs",
    "data:build": "node scripts/build-data.mjs",
    "data:refresh": "node scripts/refresh-data.mjs",
    "server": "node server/feedback.mjs",
    "dev:full": "node -e \"const {spawn}=require('child_process');const v=spawn('npm',['run','dev'],{stdio:'inherit',shell:true});const s=spawn('npm',['run','server'],{stdio:'inherit',shell:true});process.on('exit',()=>{v.kill();s.kill();})\""
  },
  "dependencies": {
    "express": "^4.22.3",
    "fuse.js": "^7.1.0",
    "maplibre-gl": "^5.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^4.8.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.0"
  }
}
